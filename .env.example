# Copy to .env.local and fill with values from your dedicated development project.
# Never commit real values. This app does not require a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Create these test-only accounts in the development project.
MINIDSP_TEST_USER_A_EMAIL=test-a@example.test
MINIDSP_TEST_USER_A_PASSWORD=replace-with-test-only-password
MINIDSP_TEST_USER_B_EMAIL=test-b@example.test
MINIDSP_TEST_USER_B_PASSWORD=replace-with-test-only-password

# Base URL of a running app for real upload integration tests.
MINIDSP_BASE_URL=http://localhost:3000
